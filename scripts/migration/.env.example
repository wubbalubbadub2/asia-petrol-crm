# scripts/migration/.env.example — copy to `.env` and fill in. NEVER commit `.env`.
#
# Read-only connection to a COPY of production (a pg_dump restored onto a
# throwaway host / branch DB). The profiler runs inside a READ ONLY transaction,
# but you must still point it at a copy — see PROFILE_TARGET_IS_COPY below.
#
# Recommended: connect as a dedicated read-only role, e.g.
#   CREATE ROLE profiler LOGIN PASSWORD '...' ;
#   GRANT CONNECT ON DATABASE postgres TO profiler ;
#   GRANT USAGE ON SCHEMA public, auth, storage TO profiler ;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public, auth, storage TO profiler ;
PROFILE_DATABASE_URL=postgresql://profiler:CHANGE_ME@copy-host:5432/postgres?sslmode=require

# Explicit human affirmation that the target above is a COPY, not live production.
# The script refuses to run unless this is exactly `true`.
PROFILE_TARGET_IS_COPY=false
